{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domstride Protocol v1 case manifest",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "name",
    "status",
    "duration_ms"
  ],
  "properties": {
    "format": {
      "const": "domstride.case"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "pending",
        "unknown"
      ]
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "producer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "framework": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "runner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "platform": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "assertions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "keyword",
          "status",
          "duration_ms"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "keyword": {
            "type": "string",
            "maxLength": 64
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1030
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "pending",
              "unknown",
              "undefined",
              "ambiguous"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "assertion_events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "kind",
          "status",
          "duration_ms"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "unknown"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "step_sequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "file",
          "label"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^video-0[1-4]\\.webm$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
