{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Domstride run v1 (documentation profile)",
  "required": [
    "format",
    "schema_version",
    "run_id",
    "mode",
    "status",
    "cases"
  ],
  "properties": {
    "format": {
      "const": "domstride.run"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,128}$"
    },
    "mode": {
      "enum": [
        "fast",
        "execution",
        "documentation"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "pending",
        "unknown"
      ]
    },
    "cases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "folder",
          "attempt_id",
          "scenario_id",
          "status"
        ],
        "properties": {
          "folder": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,128}$"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,128}$"
          },
          "scenario_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,128}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "pending",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
