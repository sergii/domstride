#!/usr/bin/env ruby
require "domstride/errors"
require "open3"

begin
  case ARGV.shift
  when "setup"
    require "domstride"
    abort "Usage: domstride setup" unless ARGV.empty?
    puts "Domstride runtime: #{Domstride::Runtime.setup!}"
  when "doctor"
    require "domstride"
    json = ARGV == ["--json"]
    abort "Usage: domstride doctor [--json]" unless ARGV.empty? || json
    settings = Domstride::Configuration.resolve
    version, status = Open3.capture2e(settings.fetch(:runtime), "--version")
    raise Domstride::Error, "Runtime version check failed" unless status.success?
    report = { domstride: Domstride::VERSION, ruby: RUBY_VERSION, runtime: settings[:runtime],
               runtime_version: version.strip, engine: settings[:engine],
               clock: settings[:clock], assets: settings[:assets],
               websocket_configured: !settings[:websocket_url].nil?,
               worker: Domstride::Runtime.worker_path }
    Domstride::Session.open(websocket_url: nil) do |page|
      page.mount_html('<p id="status">Ready</p>')
      page.assert_text("#status", "Ready")
    end
    report[:status] = "ok"
    if json
      puts JSON.pretty_generate(report)
    else
      puts "Worker: #{report[:worker]}"
      puts "Runtime check passed"
    end
  when "replay"
    require "domstride/replay"
    abort "Usage: domstride replay RECORDING_DIRECTORY [OUTPUT_HTML]" unless (1..2).cover?(ARGV.size)
    puts Domstride::Replay.export(ARGV[0], output: ARGV[1])
  when "report"
    require "domstride/report"
    abort "Usage: domstride report CASE_DIRECTORY [OUTPUT_HTML]" unless (1..2).cover?(ARGV.size)
    puts Domstride::Report.export(ARGV[0], output: ARGV[1])
  else
    abort "Usage: domstride setup | doctor [--json] | replay RECORDING_DIRECTORY [OUTPUT_HTML] | report CASE_DIRECTORY [OUTPUT_HTML]"
  end
rescue Domstride::Error, SystemCallError, ArgumentError => e
  abort "Domstride: #{e.message}"
end
